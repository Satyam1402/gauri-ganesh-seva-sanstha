APP_NAME="Gauri Ganesh Seva Sanstha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gauri-ganesh-seva-sanstha.test
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ggss_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ggss_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ggss.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEDIA_DISK=public
IMAGE_DRIVER=gd
QUEUE_CONVERSIONS_BY_DEFAULT=true

# --- Donations ---
DONATION_CURRENCY=INR
DONATION_RECEIPT_PREFIX=GGSS
DONATION_ADMIN_EMAIL=
DONATION_MIN_AMOUNT=10

# Offline gateways (shown on the donate form when enabled)
DONATION_BANK_TRANSFER_ENABLED=true
DONATION_BANK_ACCOUNT_NAME="Gauri Ganesh Seva Sanstha"
DONATION_BANK_ACCOUNT_NUMBER=
DONATION_BANK_IFSC=
DONATION_BANK_NAME=
DONATION_BANK_BRANCH=
DONATION_UPI_ENABLED=true
DONATION_UPI_VPA=
DONATION_UPI_PAYEE_NAME="Gauri Ganesh Seva Sanstha"

# Online gateways (enable after adding credentials)
RAZORPAY_ENABLED=false
RAZORPAY_KEY=
RAZORPAY_SECRET=
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# --- Events ---
EVENT_ADMIN_EMAIL=

# --- Notifications ---
# Internal alerts always go to the admin users who hold the module permission
# (in-app + email). The *_ADMIN_EMAIL keys above and below optionally copy a
# shared team mailbox as well; leave them empty to notify users only.
VOLUNTEER_ADMIN_EMAIL=
CONTACT_ADMIN_EMAIL=
# Site-wide channel switches (SMS/WhatsApp are reserved for a future phase).
NOTIFICATIONS_MAIL_ENABLED=true
NOTIFICATIONS_DATABASE_ENABLED=true
# Queue name + retry attempts for outgoing notifications (run: php artisan queue:work).
NOTIFICATIONS_QUEUE=default
NOTIFICATIONS_TRIES=3

# --- Backups (docs/BACKUPS.md) ---
# Folder holding mysqldump/mysql (XAMPP: "C:/xampp8.2/mysql/bin"; Linux: leave
# empty when they are on PATH, or e.g. /usr/bin).
DB_DUMP_BINARY_PATH=
# REQUIRED in production: AES-256 password for backup archives. Keep it
# outside the backups themselves (password manager / secret store) — without
# it no archive can be restored.
BACKUP_ARCHIVE_PASSWORD=
# Directory name inside every backup disk.
BACKUP_NAME=ggss
# Optional off-site copy to S3 or any S3-compatible store (MinIO, Backblaze B2,
# DigitalOcean Spaces…). Never needed for local development.
BACKUP_S3_ENABLED=false
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_USE_PATH_STYLE_ENDPOINT=false
# Retention (days/weeks/months/years; newest archive is always kept).
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=6
BACKUP_KEEP_YEARLY_YEARS=2
BACKUP_MAX_STORAGE_MB=5000
BACKUP_MAX_AGE_DAYS=1
# Queue + timeout for manual runs/restores from the admin panel.
BACKUP_QUEUE=default
BACKUP_JOB_TIMEOUT=3600

# --- Admin seeding ---
# Used by AdminUserSeeder for the initial Super Admin (login at /login).
# If left empty, a random password is generated and printed once during seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
